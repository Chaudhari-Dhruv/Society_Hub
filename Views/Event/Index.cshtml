@model IEnumerable<Society_hub.Models.Event>

<h1>Society Events</h1>

<p>
    <a asp-action="Create">Create New Event</a>
</p>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>Location</th>
            <th>Event Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>@item.Title</td>

                <td>@item.Description</td>

                <td>@item.Location</td>

                <td>@item.EventDate</td>

                <td>
                    <a asp-action="Registrations"
                       asp-route-id="@item.Id">
                        Registrations
                    </a>

                    |

                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>

                    |

                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>

                   
                </td>
            </tr>
        }
    </tbody>
</table>