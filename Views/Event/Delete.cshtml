@model Society_hub.Models.Event

<h1>Delete Event</h1>

<h3>Are you sure you want to delete this event?</h3>

<p>
    <strong>Title:</strong>
    @Model.Title
</p>

<p>
    <strong>Description:</strong>
    @Model.Description
</p>

<p>
    <strong>Location:</strong>
    @Model.Location
</p>

<p>
    <strong>Event Date:</strong>
    @Model.EventDate
</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">
        Delete
    </button>

    <a asp-action="Index">
        Cancel
    </a>

</form>