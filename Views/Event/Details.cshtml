@model Society_hub.Models.Event

<h1>Event Details</h1>

<p>
    <strong>Id:</strong>
    @Model.Id
</p>

<p>
    <strong>Title:</strong>
    @Model.Title
</p>

<p>
    <strong>Description:</strong>
    @Model.Description
</p>

<p>
    <strong>Location:</strong>
    @Model.Location
</p>

<p>
    <strong>Event Date:</strong>
    @Model.EventDate
</p>

<p>
    <strong>Created Date:</strong>
    @Model.CreatedDate
</p>

<h3>Registered Residents</h3>

@if (Model.EventRegistrations != null &&
     Model.EventRegistrations.Any())
{
    <ul>
        @foreach (var registration in Model.EventRegistrations)
        {
            <li>
                @registration.Resident?.FullName
            </li>
        }
    </ul>
}
else
{
    <p>No residents registered yet.</p>
}
<form asp-action="CancelRegistration"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <button type="submit">
        Cancel My Registration
    </button>

</form>

<form asp-action="Register"
      asp-route-id="@Model.Id"
      method="get">

    <button type="submit">
        Register for Event
    </button>

</form>

<br />

<a asp-action="Edit"
   asp-route-id="@Model.Id">
    Edit
</a>

|

<a asp-action="Index">
    Back to Events
</a>
