@model IEnumerable<Society_hub.Models.ApartmentBlock>

<h1>Apartment Blocks</h1>

<p>
    <a asp-action="Create">Add New Block</a>
</p>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>ID</th>
            <th>Block Name</th>
            <th>Total Flats</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.BlockName</td>
                <td>@item.TotalFlats</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Edit" asp-route-id="@item.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Delete" asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>