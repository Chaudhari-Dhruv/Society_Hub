@model IEnumerable<Society_hub.Models.Resident>

<h1>Resident List</h1>

<p>
    <a asp-action="Create">Create New Resident</a>
</p>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Family Members</th>
            <th>Flat</th>
            <th>Apartment Block</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.FamilyMembers</td>
                <td>@item.Flat?.FlatNumber</td>
                <td>@item.Flat?.ApartmentBlock?.BlockName</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>