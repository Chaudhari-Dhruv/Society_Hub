@model Society_hub.Models.Visitor

<h1>Delete Visitor</h1>

<h3>Are you sure you want to delete this visitor?</h3>

<p>
    <strong>Visitor:</strong> @Model.VisitorName
</p>

<p>
    <strong>Phone:</strong> @Model.Phone
</p>

<p>
    <strong>Purpose:</strong> @Model.Purpose
</p>

<p>
    <strong>Resident:</strong> @Model.Resident?.FullName
</p>

<p>
    <strong>Flat:</strong> @Model.Resident?.Flat?.FlatNumber
</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">Delete</button>

    <a asp-action="Index">Cancel</a>

</form>