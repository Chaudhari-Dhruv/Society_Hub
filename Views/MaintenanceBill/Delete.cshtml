@model Society_hub.Models.MaintenanceBill

<h1>Delete Maintenance Bill</h1>

<h3>Are you sure you want to delete this bill?</h3>

<p>
    <strong>Resident:</strong>
    @Model.Resident?.FullName
</p>

<p>
    <strong>Amount:</strong>
    ₹@Model.Amount
</p>

<p>
    <strong>Billing Month:</strong>
    @Model.BillingMonth.ToString("MMMM yyyy")
</p>

<p>
    <strong>Status:</strong>
    @Model.PaymentStatus
</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">
        Delete
    </button>

    <a asp-action="Index">
        Cancel
    </a>

</form>