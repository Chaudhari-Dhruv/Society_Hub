@model Society_hub.Models.MaintenanceBill

<h1>Edit Maintenance Bill</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <input type="hidden" asp-for="CreatedDate" />

    <div>
        <label>Resident</label>

        <select asp-for="ResidentId">

            @foreach (var resident in ViewBag.Residents)
            {
                <option value="@resident.Id">
                    @resident.FullName
                </option>
            }

        </select>
    </div>

    <br />

    <div>
        <label>Amount</label>
        <input asp-for="Amount" type="number" step="0.01" />
    </div>

    <br />

    <div>
        <label>Billing Month</label>
        <input asp-for="BillingMonth" type="date" />
    </div>

    <br />

    <div>
        <label>Due Date</label>
        <input asp-for="DueDate" type="date" />
    </div>

    <br />

    <div>
        <label>Payment Status</label>

        <select asp-for="PaymentStatus">
            <option value="Pending">Pending</option>
            <option value="Paid">Paid</option>
        </select>
    </div>

    <br />

    <div>
        <label>Payment Date</label>
        <input asp-for="PaymentDate" type="date" />
    </div>

    <br />

    <div>
        <label>Receipt Number</label>
        <input asp-for="ReceiptNumber" />
    </div>

    <br />

    <button type="submit">
        Save Changes
    </button>

</form>

<br />

<a asp-action="Index">
    Back to Bills
</a>