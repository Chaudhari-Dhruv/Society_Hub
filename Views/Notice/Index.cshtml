@model IEnumerable<Society_hub.Models.Notice>

<h1>Notice Board</h1>

<p>
    <a asp-action="Create">Create New Notice</a>
</p>

<table border="1" cellpadding="10">

    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Content</th>
            <th>Created Date</th>
            <th>Published Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.Title</td>

                <td>@item.Content</td>

                <td>@item.CreatedDate</td>

                <td>@item.PublishedDate</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>

                    |

                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>