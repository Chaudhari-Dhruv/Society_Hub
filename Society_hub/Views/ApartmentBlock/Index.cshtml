@model IEnumerable<Society_hub.Models.ApartmentBlock>

@{
    ViewData["Title"] = "Apartment Blocks";
}

<div class="container-fluid py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Apartment Blocks</h1>
            <p class="text-muted mb-0">
                Manage residential towers, wings, and building blocks
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Add New Block
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Registered Blocks</h5>
            <span class="badge bg-secondary">@Model.Count() Blocks</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">🏢</div>
                    <h6 class="fw-bold text-muted">No Apartment Blocks</h6>
                    <p class="text-muted small mb-0">Add your first apartment block to get started.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Block Name</th>
                                <th>Total Flats</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        #@item.Id
                                    </td>
                                    <td class="fw-semibold">
                                        @item.BlockName
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.TotalFlats Flats
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-primary">
                                                Details
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary">
                                                Edit
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>