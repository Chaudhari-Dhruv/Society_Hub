@model Society_hub.Models.Resident

<h1>Delete Resident</h1>

<h3>Are you sure you want to delete this resident?</h3>

<p>
    <strong>Name:</strong> @Model.FullName
</p>

<p>
    <strong>Email:</strong> @Model.Email
</p>

<p>
    <strong>Flat:</strong> @Model.Flat?.FlatNumber
</p>

<p>
    <strong>Apartment Block:</strong>
    @Model.Flat?.ApartmentBlock?.BlockName
</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">Delete</button>

    <a asp-action="Index">Cancel</a>

</form>