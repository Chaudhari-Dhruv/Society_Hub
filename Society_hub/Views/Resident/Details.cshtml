@model Society_hub.Models.Resident

@{
    ViewData["Title"] = "Resident Details - " + Model.FullName;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0">Resident Profile</h4>
                    <span class="badge bg-light text-primary">#@Model.Id</span>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="display-5 text-primary mb-2">👤</div>
                        <h4 class="fw-bold mb-1">@Model.FullName</h4>
                        <span class="badge bg-info text-dark">
                            @(Model.Flat != null ? "Flat " + Model.Flat.FlatNumber + " (" + Model.Flat.ApartmentBlock?.BlockName + ")" : "Flat Unassigned")
                        </span>
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-muted">Email Address:</dt>
                        <dd class="col-sm-7 fw-semibold">
                            <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                        </dd>

                        <dt class="col-sm-5 text-muted">Contact Phone:</dt>
                        <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Phone) ? "Not Provided" : Model.Phone)</dd>

                        <dt class="col-sm-5 text-muted">Family Members:</dt>
                        <dd class="col-sm-7">@Model.FamilyMembers Members</dd>

                        <dt class="col-sm-5 text-muted">Flat Number:</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-light text-dark border">
                                @(Model.Flat?.FlatNumber ?? "Not Assigned")
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-muted">Apartment Block:</dt>
                        <dd class="col-sm-7">@(Model.Flat?.ApartmentBlock?.BlockName ?? "Not Assigned")</dd>
                    </dl>

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            Edit Profile
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Back to Residents
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>