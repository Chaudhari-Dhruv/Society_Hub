@model Society_hub.Models.MaintenanceBill

@{
    ViewData["Title"] = "Create Maintenance Bill";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="fw-bold mb-0">Generate Maintenance Bill</h4>
                    <small>Issue a new billing statement to a resident</small>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="ResidentId" class="form-label fw-semibold">Resident</label>
                            <select asp-for="ResidentId" class="form-select" required>
                                <option value="">-- Select Resident --</option>
                                @if (ViewBag.Residents != null)
                                {
                                    @foreach (var resident in ViewBag.Residents)
                                    {
                                        <option value="@resident.Id">
                                            @resident.FullName
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ResidentId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-semibold">Bill Amount (₹)</label>
                            <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" placeholder="e.g. 2500.00" required />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BillingMonth" class="form-label fw-semibold">Billing Month</label>
                            <input asp-for="BillingMonth" type="date" class="form-control" required />
                            <span asp-validation-for="BillingMonth" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DueDate" class="form-label fw-semibold">Payment Due Date</label>
                            <input asp-for="DueDate" type="date" class="form-control" required />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                Issue Bill
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>