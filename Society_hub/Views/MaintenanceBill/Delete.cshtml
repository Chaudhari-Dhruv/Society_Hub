@model Society_hub.Models.MaintenanceBill

@{
    ViewData["Title"] = "Delete Maintenance Bill - #" + Model.Id;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 border-top border-danger border-4">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0 text-danger">Delete Maintenance Bill</h4>
                    <small class="text-muted">Are you sure you want to remove this maintenance statement?</small>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 small mb-4">
                        ⚠️ Warning: Deleting this bill will erase billing and receipt records for this entry.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-muted">Bill ID:</dt>
                        <dd class="col-sm-7 fw-bold">#@Model.Id</dd>

                        <dt class="col-sm-5 text-muted">Resident Name:</dt>
                        <dd class="col-sm-7 fw-bold">@(Model.Resident?.FullName ?? "N/A")</dd>

                        <dt class="col-sm-5 text-muted">Billing Month:</dt>
                        <dd class="col-sm-7">@Model.BillingMonth.ToString("MMMM yyyy")</dd>

                        <dt class="col-sm-5 text-muted">Amount:</dt>
                        <dd class="col-sm-7 fw-bold text-danger">₹@Model.Amount.ToString("N2")</dd>

                        <dt class="col-sm-5 text-muted">Payment Status:</dt>
                        <dd class="col-sm-7">@Model.PaymentStatus</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>