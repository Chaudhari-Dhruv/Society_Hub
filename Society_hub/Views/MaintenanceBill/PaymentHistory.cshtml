@model IEnumerable<Society_hub.Models.MaintenanceBill>

@{
    ViewData["Title"] = "Payment History";
}

<div class="container-fluid py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Payment History</h1>
            <p class="text-muted mb-0">
                Review your settled maintenance fees and download receipts
            </p>
        </div>
        <div>
            <a asp-action="MyBills" class="btn btn-outline-primary">
                View All Bills
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Paid Transactions</h5>
            <span class="badge bg-success">@Model.Count() Settled</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">🧾</div>
                    <h6 class="fw-bold text-muted">No Payment History</h6>
                    <p class="text-muted small mb-0">No completed payments found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Bill ID</th>
                                <th>Billing Month</th>
                                <th>Amount Paid</th>
                                <th>Payment Date</th>
                                <th>Receipt Number</th>
                                <th class="text-end pe-3">Receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        #@payment.Id
                                    </td>
                                    <td>
                                        @payment.BillingMonth.ToString("MMMM yyyy")
                                    </td>
                                    <td class="fw-bold text-success">
                                        ₹@payment.Amount.ToString("N2")
                                    </td>
                                    <td>
                                        @(payment.PaymentDate?.ToString("dd MMM yyyy") ?? "-")
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @payment.ReceiptNumber
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Receipt"
                                           asp-route-id="@payment.Id"
                                           class="btn btn-sm btn-outline-success">
                                            View Receipt
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="ResidentDashboard" asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Resident Dashboard
        </a>
    </div>

</div>