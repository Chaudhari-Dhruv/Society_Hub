@model IEnumerable<Society_hub.Models.MaintenanceBill>

@{
    ViewData["Title"] = "Maintenance Bills";
}

<div class="container-fluid py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Maintenance Bills</h1>
            <p class="text-muted mb-0">
                Generate monthly maintenance bills, collect dues, and issue receipts
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Generate New Bill
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Billing Ledger</h5>
            <span class="badge bg-secondary">@Model.Count() Bills</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">💰</div>
                    <h6 class="fw-bold text-muted">No Maintenance Bills Found</h6>
                    <p class="text-muted small mb-0">Create your first maintenance bill to issue statements to residents.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Resident</th>
                                <th>Billing Month</th>
                                <th>Amount</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Payment Date</th>
                                <th class="text-end pe-3">Actions &amp; Payment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        #@item.Id
                                    </td>
                                    <td class="fw-semibold">
                                        @(item.Resident?.FullName ?? "N/A")
                                    </td>
                                    <td>
                                        @item.BillingMonth.ToString("MMMM yyyy")
                                    </td>
                                    <td class="fw-bold">
                                        ₹@item.Amount.ToString("N2")
                                    </td>
                                    <td>
                                        @item.DueDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        @if (item.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.PaymentDate?.ToString("dd MMM yyyy") ?? "-")
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-flex justify-content-end align-items-center gap-1">
                                            @if (item.PaymentStatus != "Paid")
                                            {
                                                <form asp-action="MarkAsPaid"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden"
                                                           name="paymentDate"
                                                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                                    <input type="hidden"
                                                           name="receiptNumber"
                                                           value="REC-@item.Id-@DateTime.Now.ToString("yyyyMMddHHmmss")" />
                                                    <button type="submit" class="btn btn-sm btn-success" title="Collect payment">
                                                        Mark as Paid
                                                    </button>
                                                </form>
                                            }

                                            <div class="btn-group btn-group-sm ms-1">
                                                <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-primary">
                                                    Details
                                                </a>
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-secondary">
                                                    Edit
                                                </a>
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-danger">
                                                    Delete
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>