@model Society_hub.Models.Flat

@{
    ViewData["Title"] = "Delete Flat - " + Model.FlatNumber;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 border-top border-danger border-4">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0 text-danger">Delete Flat</h4>
                    <small class="text-muted">Are you sure you want to remove this flat?</small>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 small mb-4">
                        ⚠️ Warning: Deleting this flat will remove it permanently from the society records.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-muted">Flat Number:</dt>
                        <dd class="col-sm-7 fw-bold">Flat @Model.FlatNumber</dd>

                        <dt class="col-sm-5 text-muted">Floor Number:</dt>
                        <dd class="col-sm-7">Floor @Model.FloorNumber</dd>

                        <dt class="col-sm-5 text-muted">Occupancy Status:</dt>
                        <dd class="col-sm-7">
                            @(Model.IsOccupied ? "Occupied" : "Vacant")
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>