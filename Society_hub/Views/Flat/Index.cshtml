@model IEnumerable<Society_hub.Models.Flat>

<h1>Flat List</h1>

<p>
    <a asp-action="Create">Create New Flat</a>
</p>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>Id</th>
            <th>Flat Number</th>
            <th>Floor</th>
            <th>Occupied</th>
            <th>Apartment Block</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FlatNumber</td>
                <td>@item.FloorNumber</td>
                <td>@item.IsOccupied</td>
                <td>@item.ApartmentBlock?.BlockName</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>