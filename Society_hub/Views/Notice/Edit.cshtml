@model Society_hub.Models.Notice

<h1>Edit Notice</h1>

<form asp-action="Edit" method="post">

    <input type="hidden"
           asp-for="Id" />

    <div>
        <label>Title</label>
        <input asp-for="Title" />
    </div>

    <br />

    <div>
        <label>Content</label>
        <textarea asp-for="Content"></textarea>
    </div>

    <br />

    <button type="submit">
        Save Changes
    </button>

</form>

<br />

<a asp-action="Index">
    Back to Notice Board
</a>