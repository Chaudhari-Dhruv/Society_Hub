@model Society_hub.Models.Notice

@{
    ViewData["Title"] = "Delete Notice";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 border-top border-danger border-4">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0 text-danger">Delete Notice</h4>
                    <small class="text-muted">Are you sure you want to remove this notice?</small>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 small mb-4">
                        ⚠️ Warning: This will permanently delete the notice from the community board.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Title:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Title</dd>

                        <dt class="col-sm-4 text-muted">Published:</dt>
                        <dd class="col-sm-8">@(Model.PublishedDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</dd>

                        <dt class="col-sm-4 text-muted">Content:</dt>
                        <dd class="col-sm-8 text-muted" style="white-space: pre-line;">@Model.Content</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>