@model Society_hub.Models.Notice

@{
    ViewData["Title"] = "Notice Details - " + Model.Title;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-info text-dark mb-1">Official Society Notice</span>
                        <h4 class="fw-bold mb-0">@Model.Title</h4>
                    </div>
                    <span class="badge bg-light text-muted border">#@Model.Id</span>
                </div>

                <div class="card-body p-4">
                    <div class="text-muted small mb-3">
                        📅 Published on: <strong>@(Model.PublishedDate?.ToString("dd MMMM yyyy, hh:mm tt") ?? "-")</strong>
                    </div>

                    <div class="p-3 bg-light rounded mb-4" style="white-space: pre-line; line-height: 1.7;">
                        @Model.Content
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                                Edit Notice
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                Delete Notice
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Back to Notices
                            </a>
                        }
                        else
                        {
                            <a asp-action="ResidentNotices" class="btn btn-outline-secondary">
                                ← Back to Notices
                            </a>
                            <a asp-controller="ResidentDashboard" asp-action="Index" class="btn btn-outline-dark">
                                Resident Dashboard
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>