@model Society_hub.Models.Notice

<h1>Create Notice</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Title</label>
        <input asp-for="Title" />
    </div>

    <br />

    <div>
        <label>Content</label>
        <textarea asp-for="Content"></textarea>
    </div>

    <br />

    <button type="submit">
        Publish Notice
    </button>

</form>

<br />

<a asp-action="Index">
    Back to Notice Board
</a>