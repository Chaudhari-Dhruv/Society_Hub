<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Society Hub</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Society_hub.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar mb-4">

            <div class="container-fluid">

                <!-- Website Name -->
                <a class="navbar-brand fw-bold text-primary"
                   asp-controller="Home"
                   asp-action="Index">
                    🏢 Society Hub
                </a>


                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- ========================= -->
                    <!-- LEFT SIDE NAVIGATION -->
                    <!-- ========================= -->

                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home - Everyone -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>


                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {

                            <!-- ========================= -->
                            <!-- ADMIN MENU -->
                            <!-- ========================= -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="AdminDashboard"
                                       asp-action="Index">
                                        Admin Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="ApartmentBlock"
                                       asp-action="Index">
                                        Blocks
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Flat"
                                       asp-action="Index">
                                        Flats
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Resident"
                                       asp-action="Index">
                                        Residents
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="SecurityGuardManagement"
                                       asp-action="Index">
                                        Security Guards
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Complaint"
                                       asp-action="Index">
                                        Complaints
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Visitor"
                                       asp-action="Index">
                                        Visitors
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="MaintenanceBill"
                                       asp-action="Index">
                                        Bills
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Notice"
                                       asp-action="Index">
                                        Notices
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Event"
                                       asp-action="Index">
                                        Events
                                    </a>
                                </li>
                            }


                            <!-- ========================= -->
                            <!-- RESIDENT MENU -->
                            <!-- ========================= -->
                            @if (User.IsInRole("Resident"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="ResidentDashboard"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Complaint"
                                       asp-action="MyComplaints">
                                        My Complaints
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Visitor"
                                       asp-action="MyVisitors">
                                        My Visitors
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="MaintenanceBill"
                                       asp-action="MyBills">
                                        My Bills
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Notice"
                                       asp-action="ResidentNotices">
                                        Notices
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Event"
                                       asp-action="ResidentEvents">
                                        Events
                                    </a>
                                </li>
                            }


                            <!-- ========================= -->
                            <!-- SECURITY GUARD MENU -->
                            <!-- ========================= -->
                            @if (User.IsInRole("SecurityGuard"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="SecurityGuard"
                                       asp-action="Dashboard">
                                        Guard Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Visitor"
                                       asp-action="Index">
                                        Visitors
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="SecurityGuard"
                                       asp-action="MyProfile">
                                        My Profile
                                    </a>
                                </li>
                            }

                        }

                    </ul>


                    <!-- ========================= -->
                    <!-- RIGHT SIDE -->
                    <!-- ========================= -->

                    <ul class="navbar-nav">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {
                            <!-- Logged in user -->

                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Hello, @User.Identity.Name
                                </span>
                            </li>


                            <!-- Logout -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="nav-link btn btn-link text-dark">
                                        Logout
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- Login -->

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>


                            <!-- Register -->

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>

        </nav>

    </header>


    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- ========================= -->
    <!-- FOOTER -->
    <!-- ========================= -->

    <footer class="custom-dark-footer footer">

        <div class="container">

            &copy; 2026 - Society_hub -

            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </footer>


    <!-- ========================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>