@model IEnumerable<Society_hub.Models.SecurityGuard>

@{
    ViewData["Title"] = "Security Guards";
}

<h1>Security Guard List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add New Security Guard
    </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Shift</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>@item.FullName</td>

                <td>@item.Phone</td>

                <td>@item.Email</td>

                <td>@item.Shift</td>

                <td>
                    @(item.IsActive ? "Yes" : "No")
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>