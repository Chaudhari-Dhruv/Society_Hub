@model Society_hub.Models.SecurityGuard

@{
    ViewData["Title"] = "Delete Security Guard - " + Model.FullName;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 border-top border-danger border-4">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0 text-danger">Delete Security Guard</h4>
                    <small class="text-muted">Are you sure you want to remove this staff account?</small>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 small mb-4">
                        ⚠️ Warning: Deleting this security guard will permanently delete both their profile and their login account.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-muted">Full Name:</dt>
                        <dd class="col-sm-7 fw-bold">@Model.FullName</dd>

                        <dt class="col-sm-5 text-muted">Email:</dt>
                        <dd class="col-sm-7">@Model.Email</dd>

                        <dt class="col-sm-5 text-muted">Phone:</dt>
                        <dd class="col-sm-7">@Model.Phone</dd>

                        <dt class="col-sm-5 text-muted">Shift:</dt>
                        <dd class="col-sm-7">@Model.Shift</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>