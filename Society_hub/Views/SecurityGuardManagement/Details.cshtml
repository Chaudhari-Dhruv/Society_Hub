@model Society_hub.Models.SecurityGuard

@{
    ViewData["Title"] = "Security Guard Details - " + Model.FullName;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0">Security Guard Details</h4>
                    <span class="badge bg-light text-primary">#@Model.Id</span>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="display-5 text-primary mb-2">🛡️</div>
                        <h4 class="fw-bold mb-1">@Model.FullName</h4>
                        <span class="badge bg-info text-dark px-3 py-2">
                            @(string.IsNullOrEmpty(Model.Shift) ? "Standard Shift" : Model.Shift + " Shift")
                        </span>
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-muted">Email / Username:</dt>
                        <dd class="col-sm-7 fw-semibold">@Model.Email</dd>

                        <dt class="col-sm-5 text-muted">Phone Number:</dt>
                        <dd class="col-sm-7">@Model.Phone</dd>

                        <dt class="col-sm-5 text-muted">Assigned Shift:</dt>
                        <dd class="col-sm-7">@Model.Shift</dd>

                        <dt class="col-sm-5 text-muted">Active Duty Status:</dt>
                        <dd class="col-sm-7">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active Duty</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>
                    </dl>

                    <div class="d-flex gap-2">
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            Delete Account
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>