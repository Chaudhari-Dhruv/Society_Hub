@using Society_hub.Models

@{
    ViewData["Title"] = "Security Guard Dashboard";
    var expectedVisitors = ViewBag.ExpectedVisitors as List<Visitor> ?? new List<Visitor>();
    var checkedInVisitors = ViewBag.CheckedInVisitors as List<Visitor> ?? new List<Visitor>();
    var guard = ViewBag.Guard as SecurityGuard;
}

<div class="container-fluid py-3">

    <!-- ========================= -->
    <!-- HEADER & PROFILE SUMMARY -->
    <!-- ========================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <span class="badge bg-primary px-3 py-2 mb-2">Gate Security Operations</span>
                    <h2 class="fw-bold mb-1">
                        Welcome, @(guard?.FullName ?? User.Identity?.Name ?? "Security Guard")
                    </h2>
                    <p class="text-muted mb-0">
                        Society Gate Check-in &amp; Visitor Monitoring System
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="SecurityGuard"
                       asp-action="MyProfile"
                       class="btn btn-primary">
                        <i class="bi bi-person-circle"></i> My Profile
                    </a>
                    <a asp-controller="Visitor"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        All Visitors Log
                    </a>
                </div>
            </div>

            <hr class="my-3" />

            <!-- Guard Quick Info -->
            <div class="row g-3">
                <div class="col-sm-6 col-md-3">
                    <small class="text-muted d-block">Security Guard Name</small>
                    <span class="fw-semibold">@(guard?.FullName ?? User.Identity?.Name ?? "Guard")</span>
                </div>
                <div class="col-sm-6 col-md-3">
                    <small class="text-muted d-block">Current Shift</small>
                    <span class="badge bg-info text-dark">
                        @(string.IsNullOrEmpty(guard?.Shift) ? "Standard Shift" : guard.Shift)
                    </span>
                </div>
                <div class="col-sm-6 col-md-3">
                    <small class="text-muted d-block">Contact Phone</small>
                    <span class="fw-semibold">@(string.IsNullOrEmpty(guard?.Phone) ? "Not Provided" : guard.Phone)</span>
                </div>
                <div class="col-sm-6 col-md-3">
                    <small class="text-muted d-block">Contact Email</small>
                    <span class="fw-semibold">@(string.IsNullOrEmpty(guard?.Email) ? (User.Identity?.Name ?? "N/A") : guard.Email)</span>
                </div>
            </div>
        </div>
    </div>


    <!-- ========================= -->
    <!-- VISITOR COUNTERS -->
    <!-- ========================= -->
    <div class="row g-4 mb-4">
        <!-- Expected Visitors Count -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted text-uppercase fw-semibold mb-1 small">
                                Expected Visitors
                            </p>
                            <h1 class="fw-bold mb-0 text-warning">
                                @expectedVisitors.Count
                            </h1>
                            <small class="text-muted">Awaiting entry at society gate</small>
                        </div>
                        <div class="fs-1 text-warning">
                            ⏳
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Checked-in Visitors Count -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted text-uppercase fw-semibold mb-1 small">
                                Checked-In Visitors
                            </p>
                            <h1 class="fw-bold mb-0 text-success">
                                @checkedInVisitors.Count
                            </h1>
                            <small class="text-muted">Currently inside society premises</small>
                        </div>
                        <div class="fs-1 text-success">
                            🏢
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- ========================= -->
    <!-- EXPECTED VISITORS LIST -->
    <!-- ========================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    Expected Visitors List
                </h5>
                <small class="text-muted">Visitors scheduled to arrive who require verification and entry</small>
            </div>
            <span class="badge bg-warning text-dark px-3 py-2">
                @expectedVisitors.Count Pending
            </span>
        </div>

        <div class="card-body p-0">
            @if (!expectedVisitors.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">📋</div>
                    <h6 class="fw-bold text-muted">No Expected Visitors</h6>
                    <p class="text-muted small mb-0">No new visitors are currently scheduled for arrival.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Visitor Name</th>
                                <th>Phone</th>
                                <th>Resident</th>
                                <th>Flat</th>
                                <th>Visit Date</th>
                                <th>Purpose</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var visitor in expectedVisitors)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        @visitor.VisitorName
                                    </td>
                                    <td>
                                        <a href="tel:@visitor.Phone" class="text-decoration-none text-dark">
                                            @visitor.Phone
                                        </a>
                                    </td>
                                    <td>
                                        @(visitor.Resident?.FullName ?? "N/A")
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            Flat @(visitor.Resident?.Flat?.FlatNumber ?? "N/A")
                                        </span>
                                    </td>
                                    <td>
                                        @visitor.VisitDate.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @(string.IsNullOrEmpty(visitor.Purpose) ? "-" : visitor.Purpose)
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @visitor.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <form asp-controller="Visitor"
                                              asp-action="CheckIn"
                                              asp-route-id="@visitor.Id"
                                              asp-route-returnUrl="@Url.Action("Dashboard", "SecurityGuard")"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success px-3">
                                                Check In
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>


    <!-- ========================= -->
    <!-- CHECKED-IN VISITORS LIST -->
    <!-- ========================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    Checked-In Visitors (Currently Inside)
                </h5>
                <small class="text-muted">Active visitors present in the society who require check-out upon exit</small>
            </div>
            <span class="badge bg-success px-3 py-2">
                @checkedInVisitors.Count Active Inside
            </span>
        </div>

        <div class="card-body p-0">
            @if (!checkedInVisitors.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">🚪</div>
                    <h6 class="fw-bold text-muted">No Visitors Currently Inside</h6>
                    <p class="text-muted small mb-0">All checked-in visitors have checked out.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Visitor Name</th>
                                <th>Phone</th>
                                <th>Resident</th>
                                <th>Flat</th>
                                <th>Entry Time</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var visitor in checkedInVisitors)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        @visitor.VisitorName
                                    </td>
                                    <td>
                                        <a href="tel:@visitor.Phone" class="text-decoration-none text-dark">
                                            @visitor.Phone
                                        </a>
                                    </td>
                                    <td>
                                        @(visitor.Resident?.FullName ?? "N/A")
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            Flat @(visitor.Resident?.Flat?.FlatNumber ?? "N/A")
                                        </span>
                                    </td>
                                    <td>
                                        @(visitor.EntryTime?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                                    </td>
                                    <td>
                                        <span class="badge bg-success">
                                            @visitor.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <form asp-controller="Visitor"
                                              asp-action="CheckOut"
                                              asp-route-id="@visitor.Id"
                                              asp-route-returnUrl="@Url.Action("Dashboard", "SecurityGuard")"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger px-3">
                                                Check Out
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>