@model Society_hub.Models.SecurityGuard

@{
    ViewData["Title"] = "Security Guard Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 text-center">
                    <h4 class="fw-bold mb-0">Security Guard Profile</h4>
                    <small>Society Gate Operations Staff</small>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="display-4 text-primary mb-2">🛡️</div>
                        <h4 class="fw-bold mb-1">@Model.FullName</h4>
                        <span class="badge bg-info text-dark px-3 py-2">
                            @(string.IsNullOrEmpty(Model.Shift) ? "Standard Shift" : Model.Shift + " Shift")
                        </span>
                    </div>

                    <div class="list-group list-group-flush mb-4">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Guard ID</span>
                            <span class="fw-semibold">#@Model.Id</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Full Name</span>
                            <span class="fw-semibold">@Model.FullName</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Email</span>
                            <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Email) ? "Not Provided" : Model.Email)</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Phone Number</span>
                            <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Phone) ? "Not Provided" : Model.Phone)</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Assigned Shift</span>
                            <span class="badge bg-secondary">@Model.Shift</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Status</span>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active Duty</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="Dashboard" class="btn btn-primary">
                            Back to Guard Dashboard
                        </a>
                        <a asp-controller="Visitor" asp-action="Index" class="btn btn-outline-secondary">
                            View All Visitors Log
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
