@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<form asp-action="Login" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"></div>

    <div>
        <label>Email</label>
        <input type="email"
               name="email"
               required />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input type="password"
               name="password"
               required />
    </div>

    <br />

    <button type="submit">
        Login
    </button>

</form>

<br />

<p>
    Don't have an account?
    <a asp-action="Register">Register here</a>
</p>