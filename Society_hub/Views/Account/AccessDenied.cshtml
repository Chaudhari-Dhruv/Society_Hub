@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <div class="display-1 text-danger mb-3">⛔</div>
                    <h2 class="fw-bold text-danger">Access Denied</h2>
                    <p class="text-muted my-3">
                        You do not have permission to access this resource or perform this action.
                        Please ensure you are signed in with the appropriate account and role.
                    </p>
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            Go to Home Page
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-outline-secondary">
                                Admin Dashboard
                            </a>
                        }
                        else if (User.IsInRole("Resident"))
                        {
                            <a asp-controller="ResidentDashboard" asp-action="Index" class="btn btn-outline-secondary">
                                Resident Dashboard
                            </a>
                        }
                        else if (User.IsInRole("SecurityGuard"))
                        {
                            <a asp-controller="SecurityGuard" asp-action="Dashboard" class="btn btn-outline-secondary">
                                Guard Dashboard
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
