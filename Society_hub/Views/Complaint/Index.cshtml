@model IEnumerable<Society_hub.Models.Complaint>

@{
    ViewData["Title"] = "Complaints Management";
}

<div class="container-fluid py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Complaints Management</h1>
            <p class="text-muted mb-0">
                Track, assign, and resolve resident grievances and maintenance tickets
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Submit New Complaint
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Complaint Tickets</h5>
            <span class="badge bg-secondary">@Model.Count() Tickets</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">🎉</div>
                    <h6 class="fw-bold text-muted">No Complaints Filed</h6>
                    <p class="text-muted small mb-0">No open or historical complaints found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Resident</th>
                                <th>Flat</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th class="text-end pe-3">Actions &amp; Workflow</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        #@item.Id
                                    </td>
                                    <td class="fw-semibold">
                                        @item.Title
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(string.IsNullOrEmpty(item.Category) ? "General" : item.Category)
                                        </span>
                                    </td>
                                    <td>
                                        @(item.Resident?.FullName ?? "N/A")
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            Flat @(item.Resident?.Flat?.FlatNumber ?? "N/A")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (item.Status == "In Progress")
                                        {
                                            <span class="badge bg-info text-dark">In Progress</span>
                                        }
                                        else if (item.Status == "Resolved")
                                        {
                                            <span class="badge bg-success">Resolved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @item.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-flex justify-content-end align-items-center gap-1">
                                            @if (item.Status == "Pending")
                                            {
                                                <form asp-action="StartWork"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-info text-white">
                                                        Start Work
                                                    </button>
                                                </form>
                                            }
                                            else if (item.Status == "In Progress")
                                            {
                                                <form asp-action="Resolve"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        Resolve
                                                    </button>
                                                </form>
                                            }

                                            <div class="btn-group btn-group-sm ms-1">
                                                <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-primary">
                                                    Details
                                                </a>
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-secondary">
                                                    Edit
                                                </a>
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-danger">
                                                    Delete
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>