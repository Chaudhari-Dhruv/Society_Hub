@model Society_hub.Models.Complaint

@{
    ViewData["Title"] = "Delete Complaint - #" + Model.Id;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 border-top border-danger border-4">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0 text-danger">Delete Complaint</h4>
                    <small class="text-muted">Are you sure you want to permanently delete this complaint?</small>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 small mb-4">
                        ⚠️ Warning: Deleting this complaint will remove it from all records and dashboards.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-muted">Ticket ID:</dt>
                        <dd class="col-sm-7 fw-bold">#@Model.Id</dd>

                        <dt class="col-sm-5 text-muted">Title:</dt>
                        <dd class="col-sm-7 fw-bold">@Model.Title</dd>

                        <dt class="col-sm-5 text-muted">Category:</dt>
                        <dd class="col-sm-7">@Model.Category</dd>

                        <dt class="col-sm-5 text-muted">Resident:</dt>
                        <dd class="col-sm-7">@(Model.Resident?.FullName ?? "N/A")</dd>

                        <dt class="col-sm-5 text-muted">Status:</dt>
                        <dd class="col-sm-7">@Model.Status</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>