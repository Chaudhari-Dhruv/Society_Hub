@model Society_hub.Models.Complaint

<h1>Delete Complaint</h1>

<h3>Are you sure you want to delete this complaint?</h3>

<p>
    <strong>Title:</strong> @Model.Title
</p>

<p>
    <strong>Category:</strong> @Model.Category
</p>

<p>
    <strong>Resident:</strong> @Model.Resident?.FullName
</p>

<p>
    <strong>Status:</strong> @Model.Status
</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">Delete</button>

    <a asp-action="Index">Cancel</a>

</form>