@model Society_hub.Models.Complaint

@{
    ViewData["Title"] = "Complaint Details - " + Model.Title;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0">Complaint Details</h4>
                    <span class="badge bg-light text-primary">#@Model.Id</span>
                </div>

                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="fw-bold mb-1">@Model.Title</h4>
                            <span class="badge bg-secondary">
                                @(string.IsNullOrEmpty(Model.Category) ? "General" : Model.Category)
                            </span>
                        </div>
                        <div>
                            @if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2">Pending</span>
                            }
                            else if (Model.Status == "In Progress")
                            {
                                <span class="badge bg-info text-dark px-3 py-2">In Progress</span>
                            }
                            else if (Model.Status == "Resolved")
                            {
                                <span class="badge bg-success px-3 py-2">Resolved</span>
                            }
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded mb-4" style="white-space: pre-line;">
                        @Model.Description
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-muted">Submitted By:</dt>
                        <dd class="col-sm-7 fw-semibold">@(Model.Resident?.FullName ?? "N/A")</dd>

                        <dt class="col-sm-5 text-muted">Flat Number:</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-light text-dark border">
                                Flat @(Model.Resident?.Flat?.FlatNumber ?? "N/A")
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-muted">Submission Date:</dt>
                        <dd class="col-sm-7">@Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt")</dd>
                    </dl>

                    <div class="d-flex gap-2 border-top pt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            Edit Complaint
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            Delete
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>