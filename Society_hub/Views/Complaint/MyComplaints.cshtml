@model IEnumerable<Society_hub.Models.Complaint>

@{
    ViewData["Title"] = "My Complaints";
}

<div class="container-fluid py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Complaints</h1>
            <p class="text-muted mb-0">
                Track status and progress of complaints submitted to society administration
            </p>
        </div>
        <div>
            <a asp-action="CreateForResident" class="btn btn-primary">
                + Submit New Complaint
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Complaints Log</h5>
            <span class="badge bg-secondary">@Model.Count() Total Submitted</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">📝</div>
                    <h6 class="fw-bold text-muted">No Complaints Filed</h6>
                    <p class="text-muted small mb-3">You have not raised any issues or complaints.</p>
                    <a asp-action="CreateForResident" class="btn btn-sm btn-primary">
                        Submit a Complaint
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Complaint ID</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Submitted On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var complaint in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        #@complaint.Id
                                    </td>
                                    <td class="fw-semibold">
                                        @complaint.Title
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(string.IsNullOrEmpty(complaint.Category) ? "General" : complaint.Category)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 320px;" title="@complaint.Description">
                                            @complaint.Description
                                        </div>
                                    </td>
                                    <td>
                                        @if (complaint.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (complaint.Status == "In Progress")
                                        {
                                            <span class="badge bg-info text-dark">In Progress</span>
                                        }
                                        else if (complaint.Status == "Resolved")
                                        {
                                            <span class="badge bg-success">Resolved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@complaint.Status</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3 text-muted">
                                        @complaint.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="ResidentDashboard" asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Resident Dashboard
        </a>
    </div>

</div>