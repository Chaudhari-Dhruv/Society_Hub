@model Society_hub.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-3">

    <!-- Dashboard Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Admin Dashboard</h1>
            <p class="text-muted mb-0">
                Society overview and management administration
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Notice" asp-action="Create" class="btn btn-primary btn-sm">
                + Post Notice
            </a>
            <a asp-controller="Event" asp-action="Create" class="btn btn-outline-primary btn-sm">
                + Create Event
            </a>
        </div>
    </div>


    <!-- Statistics Cards -->
    <div class="row g-4">

        <!-- Total Residents -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Total Residents</span>
                            <h2 class="fw-bold my-2 text-primary">
                                @Model.TotalResidents
                            </h2>
                        </div>
                        <span class="fs-2 text-primary">👥</span>
                    </div>
                    <div>
                        <a asp-controller="Resident"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary w-100">
                            View Residents
                        </a>
                    </div>
                </div>
            </div>
        </div>


        <!-- Total Flats -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Total Flats</span>
                            <h2 class="fw-bold my-2 text-info">
                                @Model.TotalFlats
                            </h2>
                        </div>
                        <span class="fs-2 text-info">🏢</span>
                    </div>
                    <div>
                        <a asp-controller="Flat"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary w-100">
                            View Flats
                        </a>
                    </div>
                </div>
            </div>
        </div>


        <!-- Occupied Flats -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Occupied Flats</span>
                            <h2 class="fw-bold my-2 text-success">
                                @Model.OccupiedFlats
                            </h2>
                        </div>
                        <span class="fs-2 text-success">🔑</span>
                    </div>
                    <div class="text-muted small">
                        Currently occupied by residents
                    </div>
                </div>
            </div>
        </div>


        <!-- Vacant Flats -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 border-start border-secondary border-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Vacant Flats</span>
                            <h2 class="fw-bold my-2 text-secondary">
                                @Model.VacantFlats
                            </h2>
                        </div>
                        <span class="fs-2 text-secondary">🚪</span>
                    </div>
                    <div class="text-muted small">
                        Available for occupancy
                    </div>
                </div>
            </div>
        </div>


        <!-- Pending Complaints -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Pending Complaints</span>
                            <h2 class="fw-bold my-2 text-danger">
                                @Model.PendingComplaints
                            </h2>
                        </div>
                        <span class="fs-2 text-danger">⚠️</span>
                    </div>
                    <div>
                        <a asp-controller="Complaint"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-danger w-100">
                            Manage Complaints
                        </a>
                    </div>
                </div>
            </div>
        </div>


        <!-- Today's Visitors -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Today's Visitors</span>
                            <h2 class="fw-bold my-2 text-warning">
                                @Model.TodaysVisitors
                            </h2>
                        </div>
                        <span class="fs-2 text-warning">📋</span>
                    </div>
                    <div>
                        <a asp-controller="Visitor"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary w-100">
                            View Visitors Log
                        </a>
                    </div>
                </div>
            </div>
        </div>


        <!-- Upcoming Events -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 border-start border-purple border-4 h-100" style="border-left-color: #6f42c1 !important;">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Upcoming Events</span>
                            <h2 class="fw-bold my-2" style="color: #6f42c1;">
                                @Model.UpcomingEvents
                            </h2>
                        </div>
                        <span class="fs-2">📅</span>
                    </div>
                    <div>
                        <a asp-controller="Event"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary w-100">
                            View Events
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>