@model IEnumerable<Society_hub.Models.Visitor>

@{
    ViewData["Title"] = "Visitor Management";
}

<div class="container-fluid py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Visitor Management</h1>
            <p class="text-muted mb-0">
                Gate log, scheduled visits, and security check-in / check-out records
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    + Register New Visitor
                </a>
            }
            @if (User.IsInRole("SecurityGuard"))
            {
                <a asp-controller="SecurityGuard" asp-action="Dashboard" class="btn btn-outline-primary">
                    🛡️ Guard Dashboard
                </a>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Visitor Log</h5>
            <span class="badge bg-secondary">@Model.Count() Logged</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">👥</div>
                    <h6 class="fw-bold text-muted">No Visitors Logged</h6>
                    <p class="text-muted small mb-0">No visitor records exist at this moment.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Visitor Name</th>
                                <th>Phone</th>
                                <th>Purpose</th>
                                <th>Visit Date</th>
                                <th>Resident</th>
                                <th>Flat</th>
                                <th>Status</th>
                                <th>Entry / Exit</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        #@item.Id
                                    </td>
                                    <td class="fw-semibold">
                                        @item.VisitorName
                                    </td>
                                    <td>
                                        @item.Phone
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(item.Purpose) ? "-" : item.Purpose)
                                    </td>
                                    <td>
                                        @item.VisitDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        @(item.Resident?.FullName ?? "N/A")
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            Flat @(item.Resident?.Flat?.FlatNumber ?? "N/A")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Status == "Expected")
                                        {
                                            <span class="badge bg-warning text-dark">Expected</span>
                                        }
                                        else if (item.Status == "Checked-In")
                                        {
                                            <span class="badge bg-success">Checked-In</span>
                                        }
                                        else if (item.Status == "Checked-Out")
                                        {
                                            <span class="badge bg-secondary">Checked-Out</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@item.Status</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        In: @(item.EntryTime?.ToString("hh:mm tt") ?? "-")<br />
                                        Out: @(item.ExitTime?.ToString("hh:mm tt") ?? "-")
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-flex justify-content-end align-items-center gap-1">
                                            @if (User.IsInRole("SecurityGuard"))
                                            {
                                                @if (item.Status == "Expected")
                                                {
                                                    <form asp-action="CheckIn"
                                                          asp-route-id="@item.Id"
                                                          method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success">
                                                            Check In
                                                        </button>
                                                    </form>
                                                }
                                                else if (item.Status == "Checked-In")
                                                {
                                                    <form asp-action="CheckOut"
                                                          asp-route-id="@item.Id"
                                                          method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                            Check Out
                                                        </button>
                                                    </form>
                                                }
                                            }

                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-primary">
                                                    Details
                                                </a>
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-outline-secondary">
                                                        Edit
                                                    </a>
                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-outline-danger">
                                                        Delete
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>