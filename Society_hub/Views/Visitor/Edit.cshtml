@model Society_hub.Models.Visitor

<h1>Edit Visitor</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label>Visitor Name</label>
        <input asp-for="VisitorName" />
    </div>

    <br />

    <div>
        <label>Phone</label>
        <input asp-for="Phone" />
    </div>

    <br />

    <div>
        <label>Purpose</label>
        <input asp-for="Purpose" />
    </div>

    <br />

    <div>
        <label>Visit Date</label>
        <input asp-for="VisitDate" type="date" />
    </div>

    <br />

    <div>
        <label>Status</label>

        <select asp-for="Status">
            <option value="Expected">Expected</option>
            <option value="Checked-In">Checked-In</option>
            <option value="Checked-Out">Checked-Out</option>
        </select>
    </div>

    <br />

    <div>
        <label>Resident</label>

        <select asp-for="ResidentId">

            <option value="">-- Select Resident --</option>

            @foreach (var resident in ViewBag.Residents)
            {
                <option value="@resident.Id">
                    @resident.FullName - @resident.Flat?.FlatNumber
                </option>
            }

        </select>
    </div>

    <br />

    <button type="submit">Save</button>

</form>

<br />

<a asp-action="Index">Back to List</a>