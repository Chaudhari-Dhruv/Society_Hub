@model Society_hub.Models.Visitor

@{
    ViewData["Title"] = "Delete Visitor - " + Model.VisitorName;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 border-top border-danger border-4">
                <div class="card-header bg-white py-3">
                    <h4 class="fw-bold mb-0 text-danger">Delete Visitor Record</h4>
                    <small class="text-muted">Are you sure you want to remove this visitor record?</small>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 small mb-4">
                        ⚠️ Warning: This will permanently delete this visitor record from security logs.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-muted">Visitor Name:</dt>
                        <dd class="col-sm-7 fw-bold">@Model.VisitorName</dd>

                        <dt class="col-sm-5 text-muted">Phone Number:</dt>
                        <dd class="col-sm-7">@Model.Phone</dd>

                        <dt class="col-sm-5 text-muted">Visit Date:</dt>
                        <dd class="col-sm-7">@Model.VisitDate.ToString("dd MMM yyyy, hh:mm tt")</dd>

                        <dt class="col-sm-5 text-muted">Resident Host:</dt>
                        <dd class="col-sm-7">@(Model.Resident?.FullName ?? "N/A")</dd>

                        <dt class="col-sm-5 text-muted">Status:</dt>
                        <dd class="col-sm-7">@Model.Status</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>