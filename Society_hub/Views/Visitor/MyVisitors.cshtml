@model IEnumerable<Society_hub.Models.Visitor>

@{
    ViewData["Title"] = "My Visitors";
}

<div class="container-fluid py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Visitors</h1>
            <p class="text-muted mb-0">
                Track and register scheduled visitors for your residence
            </p>
        </div>
        <div>
            <a asp-action="CreateForResident" class="btn btn-primary">
                + Register New Visitor
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Visitor Log</h5>
            <span class="badge bg-secondary">@Model.Count() Total Registered</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="fs-2 text-muted mb-2">👥</div>
                    <h6 class="fw-bold text-muted">No Visitors Registered</h6>
                    <p class="text-muted small mb-3">You have not registered any visitors yet.</p>
                    <a asp-action="CreateForResident" class="btn btn-sm btn-primary">
                        Register Your First Visitor
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Visitor Name</th>
                                <th>Contact Phone</th>
                                <th>Purpose</th>
                                <th>Scheduled Visit Date</th>
                                <th>Status</th>
                                <th>Gate Entry Time</th>
                                <th>Gate Exit Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        @item.VisitorName
                                    </td>
                                    <td>
                                        @item.Phone
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(item.Purpose) ? "-" : item.Purpose)
                                    </td>
                                    <td>
                                        @item.VisitDate.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>
                                    <td>
                                        @if (item.Status == "Expected")
                                        {
                                            <span class="badge bg-warning text-dark">Expected</span>
                                        }
                                        else if (item.Status == "Checked-In")
                                        {
                                            <span class="badge bg-success">Checked-In</span>
                                        }
                                        else if (item.Status == "Checked-Out")
                                        {
                                            <span class="badge bg-secondary">Checked-Out</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@item.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.EntryTime?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                                    </td>
                                    <td>
                                        @(item.ExitTime?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="ResidentDashboard" asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Resident Dashboard
        </a>
    </div>

</div>
